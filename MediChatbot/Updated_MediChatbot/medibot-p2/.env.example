# MediChat Pro - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# =============================================================================
# EURON AI CONFIGURATION (REQUIRED)
# =============================================================================
# Get your Euron API key from: https://euron.one
OPENAI_API_KEY=euri-your_euron_api_key_here
OPENAI_API_BASE=https://api.euron.one/api/v1/euri
OPENAI_EMBEDDING_BASE=https://api.euron.one/api/v1/euri
OPENAI_EMBEDDING_KEY=euri-your_euron_api_key_here
LLM_MODEL=gpt-4.1-nano
EMBEDDING_MODEL=text-embedding-ada-002

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL - for reports and support tickets)
# =============================================================================
# Gmail setup with app password (not regular password)
# 1. Enable 2-Factor Authentication on Gmail
# 2. Generate App Password: Google Account → Security → App passwords
# 3. Use the 16-character app password below
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# =============================================================================
# CHROMADB CONFIGURATION (OPTIONAL - for vector storage)
# =============================================================================
# ChromaDB Cloud setup: https://www.trychroma.com/
# 1. Create account and database instance
# 2. Get API key (starts with 'ck-') and tenant ID
CHROMA_API_KEY=ck-your_chroma_api_key_here
CHROMA_TENANT=your_tenant_id_here
CHROMA_DATABASE=medibot
CHROMA_COLLECTION=medical_documents

# =============================================================================
# AWS S3 CONFIGURATION (OPTIONAL - for document storage)
# =============================================================================
# AWS S3 setup:
# 1. Create S3 bucket in your preferred region
# 2. Create IAM user with S3 permissions:
#    - s3:ListBucket, s3:GetObject, s3:PutObject, s3:DeleteObject
# 3. Generate access keys
S3_ACCESS_KEY=AKIA_your_aws_access_key
S3_SECRET_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=ap-south-1

# =============================================================================
# APPLICATION CONFIGURATION (OPTIONAL)
# =============================================================================
# Debug and logging settings
DEBUG=False
LOG_LEVEL=INFO
AUTO_VALIDATE_CONFIG=false

# Application limits
MAX_FILE_SIZE=10485760
SUPPORTED_FILE_TYPES=pdf,txt,docx
SESSION_TIMEOUT=3600

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 🔒 NEVER commit the actual .env file to version control
# 🔒 Use strong, unique passwords and API keys
# 🔒 Regularly rotate your API keys and passwords
# 🔒 Enable 2FA on all accounts where possible
# 🔒 Monitor usage and access logs regularly

# =============================================================================
# QUICK SETUP CHECKLIST
# =============================================================================
# ✅ 1. Copy this file to .env
# ✅ 2. Get Euron API key and update OPENAI_API_KEY
# ✅ 3. (Optional) Setup Gmail app password for email features
# ✅ 4. (Optional) Create ChromaDB account for vector storage
# ✅ 5. (Optional) Setup AWS S3 bucket for document storage
# ✅ 6. Run: streamlit run main.py